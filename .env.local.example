# Supabase (get these from your Supabase project's Settings -> API page)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google AI / Genkit (used by the "Ask the Imam" hint feature)
GEMINI_API_KEY=

# Moderation alerts (optional).
# Without these, reports still raise the in-app badge on the admin dashboard;
# setting them adds an email on the FIRST report of a given item. Later reports
# on the same item do not re-send — they still appear in the queue.
#   RESEND_API_KEY          from https://resend.com; enables the email channel
#   MODERATION_ALERT_EMAIL  where alerts go; comma-separate for several
#   MODERATION_ALERT_FROM   optional sender; must be a domain verified in Resend
#   NEXT_PUBLIC_SITE_URL    optional; makes the "review it" link absolute
RESEND_API_KEY=
MODERATION_ALERT_EMAIL=
MODERATION_ALERT_FROM=
NEXT_PUBLIC_SITE_URL=
